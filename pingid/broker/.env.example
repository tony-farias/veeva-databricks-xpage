# Azure Databricks workspace and Genie Agent used by this independent broker.
# Row scoping applies only when the Agent's tables are claim-scoped views; an
# Agent over unscoped tables returns the same rows to every user.
DBX_WORKSPACE_HOST=adb-7405608383447105.5.azuredatabricks.net
DBX_GENIE_AGENT_ID=01f1c1bc36b518d7b7a59b21c1bd3b92

# Fixed Databricks service principal. Store the secret only in the broker's
# secret manager or application settings. Never place it in the X-Page.
DBX_SP_CLIENT_ID=6d18456b-9dba-4ca9-9e65-d2843df4dd7a
DBX_SP_CLIENT_SECRET=
DBX_SP_DISPLAY_NAME=veeva-xpage-genie-shared
DBX_SP_OAUTH_SCOPE=all-apis

# Name of the claim in the Ping Federate bearer token that holds the end user's
# identity. Ping uses the standard `sub` claim, which carries the rep's user ID. Kong validates the token on every
# request and forwards it; the broker reads this claim from each request and
# passes its value to Databricks as the OAuth custom claim. The broker lowercases
# it, so entitlement rows must use the same spelling. Default: sub.
IDENTITY_CLAIM_NAME=sub

# Signs conversation tickets (the broker issues no session token). At least 32
# random bytes. For example: openssl rand -base64 48
STATE_ENCRYPTION_SECRET=

# Exact HTTPS origins allowed to call the broker, comma-separated. Only applies
# to browser fetch calls that send an Origin header; MyInsights ds.request calls
# are native and are not subject to CORS. Origin is not an authentication
# control (Kong validates the bearer token).
ALLOWED_PARENT_ORIGINS=https://your-gateway-origin.example.com

# Callers can have an opaque/file origin (native iPad web views). The bearer
# token forwarded by Kong remains the authentication; origin is not trusted.
ALLOW_OPAQUE_PARENT_ORIGIN=false

# Optionally accept any HTTPS origin hosted by Veeva on veevavault.com or
# veevacrm.com. A valid forwarded bearer token remains mandatory.
ALLOW_VEEVA_PARENT_ORIGINS=false

# Azure Functions hosting only: "function" (default) requires the function key,
# which Kong sends as x-functions-key; "anonymous" only when network
# restrictions already limit callers to Kong. Ignored by the standalone server.
BROKER_FUNCTION_AUTH_LEVEL=function

PORT=8787
