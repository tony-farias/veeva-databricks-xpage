# Azure Databricks workspace and Genie Agent used by this independent broker.
# Row scoping applies only when the Agent's tables are claim-scoped views; an
# Agent over unscoped tables returns the same rows to every user.
DBX_WORKSPACE_HOST=adb-7405615520098858.18.azuredatabricks.net
DBX_GENIE_AGENT_ID=01f1bda165d9188a9d8121be0cc3a9b4

# Fixed Databricks service principal. Store the secret only in the broker's
# secret manager or application settings. Never place it in the X-Page.
DBX_SP_CLIENT_ID=7cf9fe9b-c14f-4b9f-8fcf-a094f0421c7b
DBX_SP_CLIENT_SECRET=
DBX_SP_DISPLAY_NAME=veeva-xpage-genie-shared
DBX_SP_OAUTH_SCOPE=all-apis

# The native X-Page supplies the already-authenticated Vault session. The
# broker accepts it only for these exact Vault origins and validates it through
# Vault's current-user API before creating a short-lived application session.
VEEVA_VAULT_ALLOWED_ORIGINS=https://vvtechpartner-databricks-crm.veevavault.com
VEEVA_VAULT_API_VERSION=v24.1

# Which verified Vault value becomes the OAuth identity claim on every
# Databricks token: user_name (user_name__v) or federated_id (federated_id__sys).
# The broker lowercases it; entitlement rows must use the same spelling.
IDENTITY_CLAIM_SOURCE=federated_id

# Short revocation window for the encrypted application session. The X-Page
# silently revalidates its active Vault session before this expires.
BROKER_SESSION_TTL_SECONDS=900

# At least 32 random bytes. For example: openssl rand -base64 48
STATE_ENCRYPTION_SECRET=

# Exact HTTPS origins allowed to call the broker, comma-separated.
ALLOWED_PARENT_ORIGINS=https://your-vault-xpage-origin.example.com

# Native X-Pages can have an opaque/file origin. The Vault session is still
# required and validated against an explicitly allowlisted Vault instance.
ALLOW_OPAQUE_PARENT_ORIGIN=false

# Optionally accept any HTTPS X-Page origin hosted by Veeva on veevavault.com
# or veevacrm.com. A valid native Vault session remains mandatory.
ALLOW_VEEVA_PARENT_ORIGINS=false

PORT=8787
