# Azure Databricks workspace and Genie Agent used by this independent broker.
# Row scoping applies only when the Agent's tables are claim-scoped views; an
# Agent over unscoped tables returns the same rows to every user.
DBX_WORKSPACE_HOST=adb-7405608383447105.5.azuredatabricks.net
DBX_GENIE_AGENT_ID=01f1c1bc36b518d7b7a59b21c1bd3b92

# Fixed Databricks service principal. Store the secret only in the broker's
# secret manager or application settings. Never place it in the MyInsights page.
DBX_SP_CLIENT_ID=6d18456b-9dba-4ca9-9e65-d2843df4dd7a
DBX_SP_CLIENT_SECRET=
DBX_SP_DISPLAY_NAME=veeva-xpage-genie-shared
DBX_SP_OAUTH_SCOPE=all-apis

# The MyInsights page supplies the Salesforce session from getSFDCSessionID().
# The broker accepts it only for these exact instance origins (the instanceURL
# that call returns) and validates it with Salesforce's SOAP getUserInfo() call
# before creating a short-lived application session.
SALESFORCE_ALLOWED_ORIGINS=https://your-org.my.salesforce.com

# The validated session must belong to one of these organization IDs
# (Setup > Company Information; 15 or 18 characters).
SALESFORCE_ORG_IDS=00D000000000000

SALESFORCE_API_VERSION=v62.0

# Which verified Salesforce value becomes the OAuth identity claim on every
# Databricks token: username (User.Username) or federation_id
# (User.FederationIdentifier, usually the SSO subject). The broker lowercases
# it; entitlement rows must use the same spelling.
IDENTITY_CLAIM_SOURCE=federation_id

# Short revocation window for the encrypted application session. The MyInsights page
# silently revalidates its active Salesforce session before this expires.
BROKER_SESSION_TTL_SECONDS=900

# At least 32 random bytes. For example: openssl rand -base64 48
STATE_ENCRYPTION_SECRET=

# Exact HTTPS origins allowed to call the broker, comma-separated. Online,
# MyInsights content runs on a Salesforce-hosted domain; the broker logs a
# security.origin_rejected event with the exact origin to add here.
ALLOWED_PARENT_ORIGINS=https://your-org--c.vf.force.com

# The Veeva CRM iPad app opens MyInsights content from file:// with an opaque
# origin. The Salesforce session is still required and validated.
ALLOW_OPAQUE_PARENT_ORIGIN=false

# Optionally accept any HTTPS origin on force.com, salesforce.com,
# visualforce.com, or veevacrm.com. A valid session from an allowlisted
# organization remains mandatory.
ALLOW_SALESFORCE_PARENT_ORIGINS=false

PORT=8787
