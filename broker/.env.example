# Azure Databricks workspace that hosts the embedded Genie Agent.
DBX_WORKSPACE_HOST=adb-7405615520098858.18.azuredatabricks.net
DBX_GENIE_SPACE_ID=01f1b7b1764a1a04adc67a648599a233
VEEVA_SSO_ISSUER=https://login.microsoftonline.com/bf465dc7-3bc8-4944-b018-092572b5c20d/v2.0
VEEVA_SSO_AUDIENCE=4bf21bce-890d-4007-b570-fbb72ade55e2

# Confidential custom OAuth application registered in the Databricks account.
DBX_CLIENT_ID=
DBX_CLIENT_SECRET=
DBX_REDIRECT_URI=https://your-broker.example.com/auth/callback
DBX_OAUTH_SCOPES=iam.current-user:read

# Fixed same-workspace destination used after the iOS same-window OAuth flow.
# Keep this server-side so /auth/start cannot be abused as an open redirect.
DBX_GENIE_REDIRECT_URL=https://adb-7405615520098858.18.azuredatabricks.net/genie/rooms/01f1b7b1764a1a04adc67a648599a233?o=7405615520098858

# At least 32 random bytes. For example: openssl rand -base64 48
STATE_ENCRYPTION_SECRET=

# Exact HTTPS origins allowed to initiate authentication, comma-separated.
# Use the X-Page's actual runtime origin, not merely the visible Vault URL.
ALLOWED_PARENT_ORIGINS=https://your-vault-xpage-origin.example.com

# Native X-Pages can have an opaque/file origin. Enable only after testing in
# the managed Vault CRM application. The response contains no OAuth token.
ALLOW_OPAQUE_PARENT_ORIGIN=false

PORT=8787
