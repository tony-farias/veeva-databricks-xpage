# Azure Databricks workspace and the one allowlisted Genie Agent.
DBX_WORKSPACE_HOST=adb-7405615520098858.18.azuredatabricks.net
DBX_GENIE_AGENT_ID=01f1b959138b1575a09b54923fa27532

# The JWT returned by the named Veeva X-Pages SSO Configuration must match the
# Databricks account federation policy exactly. For Okta, use the custom
# authorization-server issuer and the claim whose value is the Databricks
# username. VEEVA_SSO_AUDIENCES accepts a comma-separated list when needed.
VEEVA_SSO_ISSUER=https://login.microsoftonline.com/bf465dc7-3bc8-4944-b018-092572b5c20d/v2.0
VEEVA_SSO_AUDIENCE=4bf21bce-890d-4007-b570-fbb72ade55e2
VEEVA_SSO_USERNAME_CLAIM=preferred_username

# The broker independently validates the active native Vault CRM session and
# binds that Vault username to the federated JWT and Databricks /Me identity.
VEEVA_VAULT_ALLOWED_ORIGINS=https://vvtechpartner-databricks-crm.veevavault.com
VEEVA_VAULT_API_VERSION=v24.1

# The encrypted app session never outlives either upstream token and is also
# capped at this short revocation window.
BROKER_SESSION_TTL_SECONDS=900

# At least 32 random bytes. For example: openssl rand -base64 48
STATE_ENCRYPTION_SECRET=

# Exact HTTPS origins allowed to call the broker, comma-separated.
ALLOWED_PARENT_ORIGINS=https://your-vault-xpage-origin.example.com

# Native X-Pages can have an opaque/file origin. A valid Vault session and
# matching signed user assertion remain mandatory when this is enabled.
ALLOW_OPAQUE_PARENT_ORIGIN=false

# Optionally accept HTTPS X-Page origins hosted by Veeva on veevavault.com or
# veevacrm.com. Prefer exact origins when the runtime origin is stable.
ALLOW_VEEVA_PARENT_ORIGINS=false

PORT=8787
